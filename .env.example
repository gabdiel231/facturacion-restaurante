# Copia este archivo como ".env" para desarrollo local (no se sube a GitHub),
# o configura estas mismas variables en el panel de tu hosting (Render, Railway, etc.)

# --- Base de datos ---
# En producción, el hosting normalmente la genera solo al crear el servicio
# de PostgreSQL. En local, si la dejas vacía, se usa SQLite automáticamente.
DATABASE_URL=

# --- Seguridad de la sesión ---
# Genera una cadena aleatoria larga, ej: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=cambia-esta-clave-por-una-aleatoria-larga

# --- Login del sistema ---
ADMIN_USER=admin
ADMIN_PASSWORD=cambia-esta-clave

# --- Envío de correo (opcional) ---
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
